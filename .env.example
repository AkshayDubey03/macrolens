# Node 24+. Copy to .env and replace values locally; never commit .env.
# Without APP_PASSWORD the server exposes only an in-memory sample-data demo.
APP_PASSWORD=
OPENAI_API_KEY=
# Use a model available to your API project that supports images and Structured Outputs.
OPENAI_MODEL=gpt-4.1-mini
HOST=127.0.0.1
PORT=3000
# Set true for deployment behind an HTTPS reverse proxy.
COOKIE_SECURE=false
# Keep this directory on a persistent volume when hosting.
DATA_DIR=.data
AI_DAILY_LIMIT=20
